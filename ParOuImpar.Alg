algoritmo "Teste de Variável e Módulo"

var

Numero_Escolhido: inteiro

inicio
    escreva("Digite um número que seja inteiro: ")
    leia(Numero_Escolhido)
    se (Numero_Escolhido % 2 = 0) entao
        escreva("O número ", Numero_Escolhido, " é par.")
    senao
        escreva("O número ", Numero_Escolhido, " é ímpar")
    fimse    

fimalgoritmo