algoritmo "Antecessor e Sucessor"

var

Numero, Antecessor, Sucessor: inteiro

inicio

    escreval("Me dê um número: ")
    leia(Numero)
    Antecessor <- Numero - 1
    Sucessor <- Numero + 1
    escreval("")
    escreval("O antecessor de ", Numero, " é: ", Antecessor, " e o sucessor é: ", Sucessor)

fimalgoritmo