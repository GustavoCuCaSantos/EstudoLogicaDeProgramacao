algoritmo "Leia, dois números e some"

var

PrimeiroNumero, SegundoNumero, resultado: inteiro

inicio
    escreval("Me dê o primeiro número: ")
    leia(PrimeiroNumero)
    escreval("Me dê o segundo número: ")
    leia(SegundoNumero)
    resultado <- PrimeiroNumero + SegundoNumero
    escreval("O resultado da soma é: ", resultado)


fimalgoritmo